# ---------------------------------------------------------------------------
# Client (bundled into the SPA — public by design, safe to commit values for)
# ---------------------------------------------------------------------------
# Firebase web keys identify the project; they authorise nothing. Access is
# controlled by firestore.rules and storage.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# ---------------------------------------------------------------------------
# Server (Vercel environment variables — NEVER committed, never VITE_ prefixed)
# ---------------------------------------------------------------------------

# Firebase service account key. Raw JSON, or base64 of it if your dashboard
# mangles newlines. This bypasses every security rule — treat it accordingly.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_STORAGE_BUCKET=amelior8it.firebasestorage.app

# Stripe. Test vs live is this variable and nothing else — going live is a
# config change, never a code change.
#   test: sk_test_...    live: sk_live_...
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the endpoint's signing secret in the
# Stripe dashboard once the webhook is registered.
STRIPE_WEBHOOK_SECRET=

# Delivery-proof verification (Claude vision). Without it, uploaded photos are
# left "pending" for human review rather than passed unchecked.
ANTHROPIC_API_KEY=

# Transactional email. Without it, emails are skipped and logged, not queued.
RESEND_API_KEY=
EMAIL_FROM="Amelior8 <gifts@amelior8.com>"

# Shared key for the ops endpoints. Required IN ADDITION to a Firebase account
# carrying the `role: "ops"` custom claim — the key alone grants nothing.
OPS_API_KEY=

# Absolute base URL. Used for Stripe redirects, links in emails, and the org
# invite links handed out from the portal.
APP_BASE_URL=https://amelior8.com
