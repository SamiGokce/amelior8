rules_version = '2';

// Deny by default.
//
// Three kinds of client read here — a donor, org staff, and a relay — and none
// of them writes business data. Every order, relay, receipt and review goes
// through /api with the Admin SDK, which bypasses these rules entirely. What
// is written below is only about what a browser or phone may READ.
//
// Roles come from Firebase Auth custom claims, which only the Admin SDK sets:
//   ops    -> role == "ops"
//   org    -> orgRole in ["org_admin","org_staff"] and partnerId
//   relay  -> role == "relay" and relayId, partnerId
//   donor  -> no claims
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function claims() {
      return request.auth.token;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isOps() {
      return signedIn() && claims().role == 'ops';
    }

    function isOrgOf(partnerId) {
      return signedIn()
        && claims().partnerId == partnerId
        && (claims().orgRole == 'org_admin' || claims().orgRole == 'org_staff');
    }

    function isRelay() {
      return signedIn() && claims().role == 'relay';
    }

    // ---- Catalog: public read, never client-written --------------------
    match /giftItems/{itemId} {
      allow read: if true;
      allow write: if false;
    }

    match /partners/{partnerId} {
      allow read: if true;
      allow write: if false;
    }

    match /countries/{countryCode} {
      allow read: if true;
      allow write: if false;
    }

    // ---- Donor profile: own document, profile fields only --------------
    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && !request.resource.data.keys().hasAny([
          'totalGiven', 'giftCount', 'stripeCustomerId'
        ]);

      // Money and Stripe identifiers are server-maintained — a donor must not
      // be able to inflate their own totals or attach someone else's customer.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'photoURL', 'phone', 'lastSeenAt']);

      allow delete: if false;
    }

    // ---- Orders --------------------------------------------------------
    // Read by the donor who paid, by the org fulfilling it, by the relay
    // carrying it, or by ops. Written by nobody.
    match /orders/{orderId} {
      allow read: if isOps()
        || (signedIn() && resource.data.donorUid == request.auth.uid)
        || isOrgOf(resource.data.partnerId)
        || (isRelay() && resource.data.relayId == claims().relayId);

      allow write: if false;

      // Audit trail and email log stay server-only for everyone.
      match /events/{eventId} {
        allow read, write: if false;
      }
      match /emails/{emailId} {
        allow read, write: if false;
      }
    }

    // ---- Relays --------------------------------------------------------
    // An org may read its own roster; a relay may read their own record.
    // Creation, PIN changes and deactivation are all Admin-SDK only.
    match /relays/{relayId} {
      allow read: if isOps()
        || isOrgOf(resource.data.partnerId)
        || (isRelay() && claims().relayId == relayId);
      allow write: if false;
    }

    // ---- Org membership ------------------------------------------------
    match /orgUsers/{uid} {
      allow read: if isOwner(uid) || isOps() || isOrgOf(resource.data.partnerId);
      allow write: if false;
    }

    // ---- Server-only ---------------------------------------------------
    // Invite tokens, username claims, subscriptions, payouts and webhook
    // bookkeeping are never readable by any client.
    match /orgInvites/{inviteId} {
      allow read, write: if false;
    }

    match /relayUsernames/{username} {
      allow read, write: if false;
    }

    match /subscriptions/{subscriptionId} {
      allow read, write: if false;
    }

    match /payouts/{payoutId} {
      allow read, write: if false;
    }

    match /webhookEvents/{eventId} {
      allow read, write: if false;
    }

    // Prototype data from before the rebuild. Not read, not written.
    match /donors/{donorId} {
      allow read, write: if false;
    }

    // Anything not named above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
