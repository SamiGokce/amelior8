rules_version = '2';

// Proof photos are never publicly readable and never client-writable.
//
// Both directions go through short-lived v4 signed URLs issued by /api:
// uploads by an assigned facilitator (or ops on their behalf), reads only by
// the donor who paid for that gift. Signed URLs bypass these rules by design,
// which is exactly why the rules themselves deny everything.
service firebase.storage {
  match /b/{bucket}/o {

    match /proofs/{orderId}/{fileName} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
